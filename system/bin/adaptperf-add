#!/system/bin/sh
# Adaptive Performance - Add Game Package

API_PORT=9877
PKG="$1"

[ -z "$PKG" ] && {
  echo "Usage: adaptperf-add <package>"
  echo "Example: adaptperf-add com.garena.game.df"
  exit 1
}

# Validate format
echo "$PKG" | grep -Eq '^[a-zA-Z][a-zA-Z0-9_]*(\.[a-zA-Z0-9_]+)+$' || {
  echo "ERROR: Invalid package format: $PKG"
  exit 1
}

PKG_ENCODED=$(echo "$PKG" | sed 's/\./%2E/g')

RESPONSE=$( (echo -e "GET /?action=add&pkg=$PKG_ENCODED HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"; sleep 1) | nc 127.0.0.1 $API_PORT 2>/dev/null )

if echo "$RESPONSE" | grep -q '"status":"success"'; then
  echo "OK: Package added -> $PKG"
elif echo "$RESPONSE" | grep -q 'duplicate'; then
  echo "WARN: Package already exists -> $PKG"
else
  echo "ERROR: Failed to add package -> $PKG"
  echo "$RESPONSE" | grep -o '{.*}'
fi
