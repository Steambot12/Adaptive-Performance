#!/system/bin/sh
# Adaptive Performance - Set Gaming Governor

API_PORT=9877
GOV="$1"

[ -z "$GOV" ] && {
  echo "Usage: adaptperf-setgov <governor>"
  echo "Example: adaptperf-setgov schedutil"
  exit 1
}

RESPONSE=$( (echo -e "GET /?action=set_governor&governor=$GOV HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"; sleep 1) | nc 127.0.0.1 $API_PORT 2>/dev/null )

if echo "$RESPONSE" | grep -q '"status":"success"'; then
  echo "OK: Gaming governor set -> $GOV"
else
  echo "ERROR: Failed to set governor -> $GOV (check if available)"
  echo "$RESPONSE" | grep -o '{.*}'
fi
