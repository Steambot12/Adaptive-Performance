#!/system/bin/sh
# Adaptive Performance - List Game Packages

MODULE_DIR="/data/adb/modules/adaptive_performance"
GAMES_FILE="$MODULE_DIR/game_packages.txt"

if [ ! -f "$GAMES_FILE" ] || [ ! -s "$GAMES_FILE" ]; then
  echo "No game packages registered."
  exit 0
fi

echo "Registered game packages:"
echo "-------------------------"
count=0
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && continue
  case "$line" in "#"*) continue ;; esac
  echo "  $line"
  count=$((count + 1))
done < "$GAMES_FILE"
echo "-------------------------"
echo "Total: $count package(s)"
