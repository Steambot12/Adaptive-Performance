#!/system/bin/sh
# Adaptive Performance - Set Per-App Governor

API_PORT=9877
PKG="$1"
GOV="$2"

[ -z "$PKG" ] || [ -z "$GOV" ] && {
  echo "Usage: adaptperf-setappgov <package> <governor>"
  echo "Example: adaptperf-setappgov com.instagram.android powersave"
  exit 1
}

PKG_ENCODED=$(echo "$PKG" | sed 's/\./%2E/g')

RESPONSE=$( (echo -e "GET /?action=set_app_governor&pkg=$PKG_ENCODED&governor=$GOV HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"; sleep 1) | nc 127.0.0.1 $API_PORT 2>/dev/null )

if echo "$RESPONSE" | grep -q '"status":"success"'; then
  echo "OK: Per-app governor set -> $PKG = $GOV"
else
  echo "ERROR: Failed to set per-app governor"
  echo "$RESPONSE" | grep -o '{.*}'
fi
