#!/system/bin/sh
# Adaptive Performance - Remove Game Package

API_PORT=9877
PKG="$1"

[ -z "$PKG" ] && {
  echo "Usage: adaptperf-remove <package>"
  echo "Example: adaptperf-remove com.garena.game.df"
  exit 1
}

PKG_ENCODED=$(echo "$PKG" | sed 's/\./%2E/g')

RESPONSE=$( (echo -e "GET /?action=remove&pkg=$PKG_ENCODED HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"; sleep 1) | nc 127.0.0.1 $API_PORT 2>/dev/null )

if echo "$RESPONSE" | grep -q '"status":"success"'; then
  echo "OK: Package removed -> $PKG"
else
  echo "ERROR: Failed to remove package -> $PKG"
  echo "$RESPONSE" | grep -o '{.*}'
fi
