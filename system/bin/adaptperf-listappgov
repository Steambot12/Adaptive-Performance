#!/system/bin/sh
# Adaptive Performance - List Per-App Governors

MODULE_DIR="/data/adb/modules/adaptive_performance"
APP_GOV_FILE="$MODULE_DIR/app_governors.txt"

if [ ! -f "$APP_GOV_FILE" ] || [ ! -s "$APP_GOV_FILE" ]; then
  echo "No per-app governors configured."
  exit 0
fi

echo "Per-app governor settings:"
echo "-------------------------"
count=0
while IFS='=' read -r pkg gov; do
  [ -z "$pkg" ] && continue
  pkg=$(echo "$pkg" | tr -d '\r\n\t' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  gov=$(echo "$gov" | tr -d '\r\n\t' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  echo "  $pkg = $gov"
  count=$((count + 1))
done < "$APP_GOV_FILE"
echo "-------------------------"
echo "Total: $count entry"
