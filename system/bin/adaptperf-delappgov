#!/system/bin/sh
# Adaptive Performance - Remove Per-App Governor

API_PORT=9877
PKG="$1"

[ -z "$PKG" ] && {
  echo "Usage: adaptperf-delappgov <package>"
  echo "Example: adaptperf-delappgov com.instagram.android"
  exit 1
}

PKG_ENCODED=$(echo "$PKG" | sed 's/\./%2E/g')

RESPONSE=$( (echo -e "GET /?action=remove_app_governor&pkg=$PKG_ENCODED HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"; sleep 1) | nc 127.0.0.1 $API_PORT 2>/dev/null )

if echo "$RESPONSE" | grep -q '"status":"success"'; then
  echo "OK: Per-app governor removed -> $PKG"
else
  echo "ERROR: Failed to remove per-app governor"
  echo "$RESPONSE" | grep -o '{.*}'
fi
